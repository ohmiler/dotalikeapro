---
import { getNav } from '../nav';

interface Props {
	current: string;
}
const { current } = Astro.props;
const nav = await getNav();
---

<nav class="side-nav" aria-label="บทเรียน">
	{
		nav.map((s) => (
			<section>
				<h2 class="label">{s.label}</h2>
				<ul>
					{s.items.map((e) => (
						<li>
							<a href={`/${e.id}/`} aria-current={e.id === current ? 'page' : undefined}>
								{e.data.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</nav>

<style>
	.side-nav section + section { margin-top: 1.4rem; }
	.label {
		display: block;
		margin: 0 0 0.5rem;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--slate);
	}
	.label::after { display: none; }
	ul { list-style: none; margin: 0; padding: 0; }
	a {
		display: block;
		padding: 0.35rem 0.7rem;
		border-left: 2px solid transparent;
		border-radius: 0 var(--radius) var(--radius) 0;
		font-size: 0.88rem;
		line-height: 1.4;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition: color 0.2s, background 0.2s;
	}
	a:hover { color: var(--ivory); background: rgba(135, 146, 143, 0.08); }
	a[aria-current='page'] {
		color: var(--chartreuse);
		background: rgba(200, 245, 96, 0.08);
		border-left-color: var(--chartreuse);
	}
	@media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
